# ---- Application ----
APP_NAME=MediVault API
APP_ENV=production
APP_VERSION=0.1.0
DEBUG=false

# ---- Database (Managed Cloud Database URL) ----
# Supports MySQL (TiDB Cloud, Aiven, Railway) or PostgreSQL (Neon, Supabase, Render)
# Examples:
#   DATABASE_URL=mysql+pymysql://<user>:<password>@<host>:3306/<database>?ssl_ca=/etc/ssl/certs/ca-certificates.crt
#   DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>?sslmode=require
DATABASE_URL=

# Legacy individual MySQL parameters (if not using DATABASE_URL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=medivault_user
DB_PASSWORD=change_me
DB_NAME=medivault

# ---- CORS (comma-separated public frontend origins) ----
# In production, set this to your deployed frontend domain (e.g. Vercel)
# Example: CORS_ORIGINS=https://my-medivault.vercel.app
CORS_ORIGINS=https://localhost:5173,http://localhost:5173

# ---- Storage ----
STORAGE_DIR=storage
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STORAGE_ENCRYPTION_KEY=

# ---- JWT Authentication ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
